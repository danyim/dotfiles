#!/usr/bin/env python3
"""Guard: refuse a vault write that violates the Obsidian note standard.

One script, three entry points, because every harness reports writes differently:

  obsidian-guard --tool write --path P [--content-file F]     # write_file style
  obsidian-guard --claude-hook                                # Claude Code PreToolUse JSON on stdin
  obsidian-guard --hermes-hook                                # Hermes plugin JSON on stdin

Exit 0 = allowed (or not a vault note). Exit 2 = blocked; the reason goes to stderr, which both
Claude Code and the Hermes plugin feed back to the model.

Nothing here rewrites notes. It only refuses, so a legacy note edited in place fails only on
rules that matter for the edit's own content.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

SCRIPT = Path.home() / "dev" / "dotfiles" / "skills" / "obsidian-notes" / "scripts" / "obsidian_lint.py"
FALLBACK = Path.home() / ".local" / "share" / "obsidian-notes" / "scripts" / "obsidian_lint.py"


def lint_script() -> Path:
    for cand in (SCRIPT, FALLBACK):
        if cand.is_file():
            return cand
    return SCRIPT


def vault_for(path: Path) -> Path | None:
    for parent in [path] + list(path.parents):
        if (parent / ".obsidian").exists():
            return parent
    return None


def check_write(path: Path, text: str, lenient: bool) -> int:
    vault = vault_for(path)
    if vault is None:
        return 0
    rel = path.relative_to(vault).as_posix()
    proc = subprocess.run(
        [sys.executable, str(lint_script()), "--vault", str(vault), "--stdin", "--path-as", rel]
        + (["--lenient"] if lenient else []),
        input=text, capture_output=True, text=True, timeout=30,
    )
    return block(path, (proc.stderr or proc.stdout).strip()) if proc.returncode != 0 else 0


def block(path: Path, reason: str) -> int:
    sys.stderr.write(
        f"obsidian-guard blocked {path}:\n{reason}\n\n"
        "Fix the note to satisfy the standard in skills/obsidian-notes/SKILL.md "
        "(frontmatter created/updated, '# Title', footer with Status/Tags/Links/References, "
        "wikilink tags), or scaffold a compliant note with:\n"
        "  obsidian-lint --new \"Title\" --folder <folder> --tags \"Tag1,Tag2\"\n"
    )
    return 2


def apply_edit(path: Path, old: str, new: str, replace_all: bool) -> str | None:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    if old not in text:
        return None
    return text.replace(old, new) if replace_all else text.replace(old, new, 1)


def main() -> int:
    argv = sys.argv[1:]
    if "--claude-hook" in argv:
        payload = json.load(sys.stdin)
        tool = payload.get("tool_name", "")
        inp = payload.get("tool_input", {}) or {}
        raw = inp.get("file_path") or inp.get("path") or ""
        if not raw:
            return 0
        path = Path(raw).expanduser()
        if not path.exists() and not inp.get("content"):
            return 0
        if tool in ("Write", "write_file"):
            return check_write(path, inp.get("content", ""), lenient=path.exists())
        if tool in ("Edit", "MultiEdit", "patch"):
            text = apply_edit(path, inp.get("old_string", ""), inp.get("new_string", ""),
                              bool(inp.get("replace_all")))
            return check_write(path, text, lenient=True) if text is not None else 0
        return 0

    if "--hermes-hook" in argv:
        payload = json.load(sys.stdin)
        tool = payload.get("tool_name", "")
        args = payload.get("args", {}) or {}
        raw = args.get("path") or args.get("file_path") or ""
        if not raw:
            return 0
        path = Path(raw).expanduser()
        if tool == "write_file":
            return check_write(path, args.get("content", ""), lenient=path.exists())
        if tool == "patch":
            text = apply_edit(path, args.get("old_string", ""), args.get("new_string", ""),
                              bool(args.get("replace_all")))
            return check_write(path, text, lenient=True) if text is not None else 0
        return 0

    # direct mode
    path = None
    content_file = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--path":
            path = Path(argv[i + 1]).expanduser(); i += 2; continue
        if a == "--content-file":
            content_file = argv[i + 1]; i += 2; continue
        if a in ("--tool",):
            i += 2; continue
        i += 1
    if path is None:
        print("usage: obsidian-guard --path P [--content-file F] | --claude-hook | --hermes-hook",
              file=sys.stderr)
        return 0
    text = Path(content_file).read_text(encoding="utf-8") if content_file else sys.stdin.read()
    return check_write(path, text, lenient=path.exists())


if __name__ == "__main__":
    sys.exit(main())
